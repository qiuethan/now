# Copy this file to `.env` and fill in your keys for local `npm run generate`.
# `.env` is gitignored. In GitHub Actions these come from repo secrets instead.

# PAT for GitHub contributions and private repos (for include_private)
GH_PAT=
# Optional AI weekly summary + anonymized private-repo blurbs
OPENAI_API_KEY=
# Optional model override (default: gpt-5.4-mini)
# NOW_LLM_MODEL=

# Optional local aggregate snapshot override. The macOS sync installer sets up
# ~/Library/Application Support/now-activitywatch/summary.json automatically.
# ACTIVITYWATCH_SNAPSHOT_PATH=
# GitHub Actions reads ACTIVITYWATCH_SUMMARY from a repository variable.
